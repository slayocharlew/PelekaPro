{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:js": "node --test tests/JavaScript/*.test.js",
        "test:firebase-rules": "firebase emulators:exec --only database --project demo-pelekapro \"node --test tests/Firebase/*.test.js\"",
        "load:firebase": "firebase emulators:exec --only database --project demo-pelekapro-load \"node scripts/load/firebase-tracking-load.mjs\""
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "firebase-tools": "^15.28.1",
        "laravel-echo": "^2.4.0",
        "laravel-vite-plugin": "^3.1",
        "pusher-js": "^8.6.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "firebase": "^12.18.0"
    }
}
